# Optional Gemini key (synthesis; also required for the explicit Gemini embedding provider)
GEMINI_API_KEY=

# Leave blank for persistent embedded Qdrant (no server required).
# Server example: http://localhost:6333
# Cloud example: https://your-cluster.region.cloud.qdrant.io:6333
QDRANT_URL=
QDRANT_API_KEY=
# Relative paths resolve from the repository root.
QDRANT_PATH=data/qdrant_storage
# Collections include modality, dimension, and a versioned embedding-profile signature.
QDRANT_COLLECTION_PREFIX=crisisnav

# Optional local incident registry override; defaults to data/incident_reports.json.
INCIDENT_REPORTS_PATH=

# Explicit embedding provider: hash (offline default) or gemini.
# Setting GEMINI_API_KEY alone does not change the embedding provider.
EMBEDDING_PROVIDER=hash
# Blank uses 128 for hash or 768 for gemini. Gemini uses gemini-embedding-001.
EMBEDDING_DIM=
